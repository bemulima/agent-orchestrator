{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "references", "proposals"],
  "properties": {
    "answer": { "type": "string", "minLength": 1, "maxLength": 30000 },
    "references": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_type", "resource_id", "label"],
        "properties": {
          "resource_type": { "type": "string", "enum": ["project", "plan", "run", "task"] },
          "resource_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "label": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "resource_type", "resource_id", "title", "description", "risk_level"],
        "properties": {
          "action": { "type": "string", "minLength": 1, "maxLength": 64 },
          "resource_type": { "type": "string", "enum": ["plan", "run", "task"] },
          "resource_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        }
      }
    }
  }
}
