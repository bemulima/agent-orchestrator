{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "risk_level", "risks", "tasks", "dependencies"],
  "properties": {
    "summary": {"type": "string", "minLength": 10, "maxLength": 2000},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "risks": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 3, "maxLength": 2000}},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "description", "acceptance_criteria", "risk_level", "changes_contracts", "requires_migration"],
        "properties": {
          "key": {"type": "string", "minLength": 1, "maxLength": 255},
          "title": {"type": "string", "minLength": 10, "maxLength": 255},
          "description": {"type": "string", "minLength": 30, "maxLength": 12000},
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {"type": "string", "minLength": 5, "maxLength": 2000}
          },
          "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "changes_contracts": {"type": "boolean"},
          "requires_migration": {"type": "boolean"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_key", "depends_on_task_key", "dependency_type"],
        "properties": {
          "task_key": {"type": "string", "minLength": 1, "maxLength": 255},
          "depends_on_task_key": {"type": "string", "minLength": 1, "maxLength": 255},
          "dependency_type": {"type": "string", "enum": ["prerequisite"]}
        }
      }
    }
  }
}
