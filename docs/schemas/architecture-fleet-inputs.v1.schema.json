{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repositories"
  ],
  "properties": {
    "schema_version": {
      "const": "architecture-fleet-inputs.v1"
    },
    "repositories": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "source_identity",
          "remote_url",
          "commit_sha",
          "profile",
          "service_id",
          "repository_role",
          "declarations"
        ],
        "properties": {
          "repository_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "source_identity": {
            "type": "string",
            "pattern": "^git:github\\.com/"
          },
          "remote_url": {
            "type": "string",
            "pattern": "^https://github\\.com/.+\\.git$"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "service_id": {
            "type": "string",
            "minLength": 1
          },
          "repository_role": {
            "enum": [
              "service",
              "frontend",
              "infrastructure",
              "policy",
              "content",
              "documentation",
              "archive"
            ]
          },
          "declarations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "blob_oid",
                "content_sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "blob_oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "external_owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "source_identity",
          "remote_url",
          "commit_sha",
          "service_id",
          "repository_role",
          "declarations",
          "classification"
        ],
        "properties": {
          "repository_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "source_identity": {
            "type": "string",
            "pattern": "^git:github\\.com/"
          },
          "remote_url": {
            "type": "string",
            "pattern": "^https://github\\.com/.+\\.git$"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "service_id": {
            "type": "string",
            "minLength": 1
          },
          "repository_role": {
            "enum": [
              "service",
              "frontend",
              "infrastructure",
              "policy",
              "content",
              "documentation",
              "archive"
            ]
          },
          "declarations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "blob_oid",
                "content_sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "blob_oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "classification": {
            "const": "PINNED_EXTERNAL_OWNER_INPUT"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-fleet-inputs.v1.schema.json"
}
