{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-graph-inventory.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_identities"
  ],
  "properties": {
    "schema_version": {
      "const": "architecture-graph-inventory.v1"
    },
    "source_identities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
