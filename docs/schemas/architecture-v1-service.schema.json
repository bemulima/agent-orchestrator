{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bemulima.github.io/agent-orchestrator/schemas/architecture-v1-service.schema.json",
  "title": "Architecture service manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "id", "manifest_revision", "identity", "purpose", "responsibilities", "capabilities", "owned_resources", "inbound_interfaces", "outbound_dependencies", "endpoint_groups", "produced_contracts", "consumed_contracts", "published_events", "subscribed_events", "business_rules", "operation_manifests", "evidence", "confidence"],
  "properties": {
    "schema": {"const": "architecture/v1"},
    "kind": {"const": "service"},
    "id": {"type": "string", "minLength": 1},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "identity": {"$ref": "#/$defs/serviceIdentity"},
    "purpose": {"$ref": "#/$defs/statement"},
    "responsibilities": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "owned_resources": {"type": "array", "items": {"$ref": "#/$defs/ownedResource"}},
    "inbound_interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}},
    "outbound_dependencies": {"type": "array", "items": {"$ref": "#/$defs/externalInteraction"}},
    "endpoint_groups": {"type": "array", "items": {"$ref": "#/$defs/endpointGroup"}},
    "produced_contracts": {"type": "array", "items": {"$ref": "#/$defs/contractReference"}},
    "consumed_contracts": {"type": "array", "items": {"$ref": "#/$defs/contractReference"}},
    "published_events": {"type": "array", "items": {"$ref": "#/$defs/contractReference"}},
    "subscribed_events": {"type": "array", "items": {"$ref": "#/$defs/contractReference"}},
    "business_rules": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "operation_manifests": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_path"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "symbol": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "checksum": {"type": "string"}
      }
    },
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "serviceIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {"name": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}}
    },
    "ownedResource": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "name", "description"],
      "properties": {"type": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/statement"}}
    },
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["transport", "name", "description"],
      "properties": {"transport": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/statement"}}
    },
    "endpointGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "operations"],
      "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/statement"}, "operations": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    },
    "contractReference": {
      "type": "object", "additionalProperties": false,
      "required": ["transport", "code", "direction", "description"],
      "properties": {"transport": {"type": "string", "minLength": 1}, "code": {"type": "string", "minLength": 1}, "direction": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/statement"}}
    },
    "externalInteraction": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "transport", "target", "direction", "description"],
      "properties": {"id": {"type": "string", "minLength": 1}, "transport": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "contract": {"type": "string"}, "direction": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/statement"}}
    }
  }
}
