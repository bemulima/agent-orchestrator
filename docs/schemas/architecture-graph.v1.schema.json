{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-graph.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "producer",
    "references",
    "edges",
    "completeness",
    "diagnostics",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "architecture-graph.v1"
    },
    "mode": {
      "const": "CURRENT"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "commit_sha"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_count",
        "covered_service_count",
        "uncovered_service_count",
        "total_discovered_operations",
        "http_operations",
        "nats_request_reply_operations",
        "event_operations",
        "worker_operations",
        "scheduled_operations",
        "operations_with_manifests",
        "operations_missing_manifests",
        "operations_blocked",
        "declared_operation_manifest_count",
        "parsed_operation_manifest_count",
        "missing_declared_operation_manifest_count",
        "unexpected_parsed_operation_manifest_count",
        "manifest_operations_without_discovery",
        "group_operation_reference_count",
        "missing_group_operation_count",
        "operation_kinds"
      ],
      "properties": {
        "source_count": {
          "type": "integer",
          "minimum": 0
        },
        "covered_service_count": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered_service_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_discovered_operations": {
          "type": "integer",
          "minimum": 0
        },
        "http_operations": {
          "type": "integer",
          "minimum": 0
        },
        "nats_request_reply_operations": {
          "type": "integer",
          "minimum": 0
        },
        "event_operations": {
          "type": "integer",
          "minimum": 0
        },
        "worker_operations": {
          "type": "integer",
          "minimum": 0
        },
        "scheduled_operations": {
          "type": "integer",
          "minimum": 0
        },
        "operations_with_manifests": {
          "type": "integer",
          "minimum": 0
        },
        "operations_missing_manifests": {
          "type": "integer",
          "minimum": 0
        },
        "operations_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "declared_operation_manifest_count": {
          "type": "integer",
          "minimum": 0
        },
        "parsed_operation_manifest_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_declared_operation_manifest_count": {
          "type": "integer",
          "minimum": 0
        },
        "unexpected_parsed_operation_manifest_count": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_operations_without_discovery": {
          "type": "integer",
          "minimum": 0
        },
        "group_operation_reference_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_group_operation_count": {
          "type": "integer",
          "minimum": 0
        },
        "operation_kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "count"
            ],
            "properties": {
              "type": {
                "enum": [
                  "http",
                  "nats_request_reply",
                  "nats_event_subscriber",
                  "worker",
                  "scheduled"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pin",
        "source_identities"
      ],
      "properties": {
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "source_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fleet_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "content_sha256",
        "source_identities"
      ],
      "properties": {
        "schema_version": {
          "const": "architecture-fleet-inputs.v1"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_identities": {
          "type": "array",
          "minItems": 42,
          "maxItems": 42,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "operation_semantic_debt": {
      "type": "integer",
      "minimum": 0
    },
    "excluded_interface_metadata": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_identity",
        "commit_sha",
        "path",
        "blob_oid",
        "content_sha256"
      ],
      "properties": {
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "pattern": "^/"
              }
            },
            {
              "not": {
                "pattern": "(^|/)\\.\\.?(/|$)"
              }
            },
            {
              "not": {
                "pattern": "\\\\"
              }
            }
          ]
        },
        "blob_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "source_identity",
        "manifest_id",
        "repository_role",
        "commit_sha",
        "covered",
        "source_current",
        "is_dirty",
        "declaration_pins"
      ],
      "properties": {
        "reference_id": {
          "type": "string",
          "pattern": "^ref-[a-f0-9]{64}$"
        },
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "repository_role": {
          "enum": [
            "service",
            "frontend",
            "infrastructure",
            "content",
            "policy",
            "documentation",
            "archive",
            "unknown"
          ]
        },
        "commit_sha": {
          "type": "string"
        },
        "covered": {
          "type": "boolean"
        },
        "source_current": {
          "type": "boolean"
        },
        "is_dirty": {
          "type": "boolean"
        },
        "declaration_pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "reference_kind": {
          "enum": [
            "repository",
            "external"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "relation",
        "source_reference_id",
        "operation_id",
        "transport",
        "contract",
        "direction",
        "declaration_pins"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "pattern": "^edge-[a-f0-9]{64}$"
        },
        "relation": {
          "enum": [
            "outbound_dependency",
            "operation_external_interaction",
            "contract",
            "event"
          ]
        },
        "source_reference_id": {
          "type": "string",
          "pattern": "^ref-[a-f0-9]{64}$"
        },
        "target_reference_id": {
          "type": "string",
          "pattern": "^ref-[a-f0-9]{64}$"
        },
        "external_target": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "declaration_pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pin"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "target_reference_id"
          ]
        },
        {
          "required": [
            "external_target"
          ]
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "BLOCKED",
            "FAIL"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "reference_id": {
          "type": "string"
        },
        "edge_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
