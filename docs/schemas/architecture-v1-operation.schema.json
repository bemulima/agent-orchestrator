{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bemulima.github.io/agent-orchestrator/schemas/architecture-v1-operation.schema.json",
  "title": "Architecture operation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "id", "manifest_revision", "service_id", "type", "identity", "access", "trigger", "input", "business_task", "business_process", "business_rules", "implementation", "data_access", "external_interactions", "side_effects", "output", "errors", "evidence", "confidence"],
  "properties": {
    "schema": {"const": "architecture/v1"},
    "kind": {"const": "operation"},
    "id": {"type": "string", "minLength": 1},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "service_id": {"type": "string", "minLength": 1},
    "type": {"enum": ["http", "nats_request_reply", "nats_event_subscriber", "worker", "scheduled"]},
    "identity": {"$ref": "#/$defs/identity"},
    "access": {"$ref": "#/$defs/access"},
    "trigger": {"$ref": "#/$defs/trigger"},
    "input": {"$ref": "#/$defs/input"},
    "business_task": {"$ref": "#/$defs/statement"},
    "business_process": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "business_rules": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "implementation": {"$ref": "#/$defs/implementation"},
    "data_access": {"type": "array", "items": {"$ref": "#/$defs/dataAccess"}},
    "external_interactions": {"type": "array", "items": {"$ref": "#/$defs/externalInteraction"}},
    "side_effects": {"type": "array", "items": {"$ref": "#/$defs/sideEffect"}},
    "output": {"$ref": "#/$defs/output"},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "http"}}}, "then": {"properties": {"identity": {"required": ["http"]}}}},
    {"if": {"properties": {"type": {"enum": ["nats_request_reply", "nats_event_subscriber"]}}}, "then": {"properties": {"identity": {"required": ["nats"]}}}},
    {"if": {"properties": {"type": {"const": "worker"}}}, "then": {"properties": {"identity": {"required": ["worker"]}}}},
    {"if": {"properties": {"type": {"const": "scheduled"}}}, "then": {"properties": {"identity": {"required": ["scheduled"]}}}}
  ],
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["source_path"], "properties": {"source_path": {"type": "string", "minLength": 1}, "symbol": {"type": "string"}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "checksum": {"type": "string"}}},
    "statement": {"type": "object", "additionalProperties": false, "required": ["value", "confidence", "evidence"], "properties": {"value": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["transport"], "properties": {"transport": {"type": "string", "minLength": 1}, "http": {"$ref": "#/$defs/httpIdentity"}, "nats": {"$ref": "#/$defs/natsIdentity"}, "worker": {"$ref": "#/$defs/workerIdentity"}, "scheduled": {"$ref": "#/$defs/scheduledIdentity"}}},
    "httpIdentity": {"type": "object", "additionalProperties": false, "required": ["method", "path"], "properties": {"method": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}},
    "natsIdentity": {"type": "object", "additionalProperties": false, "required": ["subject", "role"], "properties": {"subject": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "queue": {"type": "string", "minLength": 1}, "mode": {"type": "string", "minLength": 1}}},
    "workerIdentity": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}},
    "scheduledIdentity": {"type": "object", "additionalProperties": false, "required": ["name", "schedule"], "properties": {"name": {"type": "string", "minLength": 1}, "schedule": {"type": "string", "minLength": 1}}},
    "access": {"type": "object", "additionalProperties": false, "required": ["audience", "authentication", "authorization", "idempotency"], "properties": {"audience": {"$ref": "#/$defs/statement"}, "authentication": {"$ref": "#/$defs/statement"}, "authorization": {"$ref": "#/$defs/statement"}, "idempotency": {"$ref": "#/$defs/statement"}}},
    "trigger": {"type": "object", "additionalProperties": false, "required": ["description"], "properties": {"description": {"$ref": "#/$defs/statement"}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["path_params", "query", "headers"], "properties": {"path_params": {"type": "array", "items": {"$ref": "#/$defs/inputField"}}, "query": {"type": "array", "items": {"$ref": "#/$defs/inputField"}}, "headers": {"type": "array", "items": {"$ref": "#/$defs/inputField"}}, "body": {"$ref": "#/$defs/schemaRef"}}},
    "inputField": {"type": "object", "additionalProperties": false, "required": ["name", "required", "description"], "properties": {"name": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "description": {"$ref": "#/$defs/statement"}}},
    "schemaRef": {"type": "object", "additionalProperties": false, "required": ["name", "description"], "properties": {"name": {"type": "string", "minLength": 1}, "schema": {"type": "object", "propertyNames": {"pattern": "^(?!.*(password|token|secret|credential|api[_-]?key|access[_-]?token|private[_-]?key)).*$"}}, "description": {"$ref": "#/$defs/statement"}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["id", "description", "interactions"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/statement"}, "interactions": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["router", "handler", "use_cases", "domain_services", "repositories"], "properties": {"router": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "handler": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "use_cases": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "domain_services": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "repositories": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}},
    "dataAccess": {"type": "object", "additionalProperties": false, "required": ["resource", "access", "description"], "properties": {"resource": {"type": "string", "minLength": 1}, "access": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/statement"}}},
    "externalInteraction": {"type": "object", "additionalProperties": false, "required": ["id", "transport", "target", "direction", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "transport": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "contract": {"type": "string"}, "direction": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/statement"}}},
    "sideEffect": {"type": "object", "additionalProperties": false, "required": ["type", "description"], "properties": {"type": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/statement"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["responses", "emitted_events"], "properties": {"responses": {"type": "array", "items": {"$ref": "#/$defs/response"}}, "result": {"$ref": "#/$defs/schemaRef"}, "emitted_events": {"type": "array", "items": {"$ref": "#/$defs/contractReference"}}}},
    "response": {"type": "object", "additionalProperties": false, "required": ["status_code", "description"], "properties": {"status_code": {"type": "integer", "minimum": 100, "maximum": 599}, "description": {"$ref": "#/$defs/statement"}, "body": {"$ref": "#/$defs/schemaRef"}}},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "description"], "properties": {"code": {"type": "string", "minLength": 1}, "status_code": {"type": "integer", "minimum": 100, "maximum": 599}, "description": {"$ref": "#/$defs/statement"}}},
    "contractReference": {"type": "object", "additionalProperties": false, "required": ["transport", "code", "direction", "description"], "properties": {"transport": {"type": "string", "minLength": 1}, "code": {"type": "string", "minLength": 1}, "direction": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/statement"}}}
  }
}
