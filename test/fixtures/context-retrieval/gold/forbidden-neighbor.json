{
  "schema": "retrieval-gold/v1",
  "id": "forbidden-neighbor",
  "scenario": "Unadmitted neighbor cannot become retrieval scope",
  "mode": "prepare",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    },
    "required_facets": [
      {
        "id": "neighbor",
        "kind": "source",
        "query_kind": "exact",
        "source_identity": "neighbor",
        "path": "source.go",
        "claim_type": "implementation_behavior"
      }
    ]
  },
  "expected": {
    "status": "BLOCKED",
    "diagnostics": [
      "SOURCE_NOT_ADMITTED"
    ],
    "must_not_find": [
      {
        "source": "neighbor",
        "path": "source.go"
      }
    ],
    "must_not_route_writes": [
      "neighbor"
    ]
  },
  "files": []
}
