{
  "schema": "retrieval-gold/v1",
  "id": "stale-docs-source",
  "scenario": "Stale docs versus current source",
  "mode": "quality",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    }
  },
  "expected": {
    "status": "PARTIAL",
    "must_find": [
      {
        "path": "source.go"
      }
    ],
    "must_not_find": [
      {
        "path": "README.md"
      }
    ],
    "diagnostics": [
      "EVIDENCE_FRESHNESS_STALE"
    ],
    "authority_conflicts": [
      "record.behavior"
    ]
  },
  "candidates": [
    {
      "relative_path": "README.md",
      "content": "Old documented behavior",
      "provenance": "PROJECT_DOC",
      "freshness": "STALE",
      "claim_key": "record.behavior",
      "claim_value": "old"
    },
    {
      "relative_path": "source.go",
      "content": "Current behavior",
      "claim_key": "record.behavior",
      "claim_value": "current",
      "required": true
    }
  ]
}
