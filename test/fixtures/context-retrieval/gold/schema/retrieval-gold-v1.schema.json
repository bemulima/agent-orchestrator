{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrieval-gold/v1",
  "title": "Deterministic retrieval gold case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "scenario", "mode", "request", "expected"],
  "properties": {
    "schema": {"const": "retrieval-gold/v1"},
    "id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "adversarial": {"type": "boolean"},
    "mode": {"enum": ["prepare", "expand", "quality", "routing_coverage"]},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "request": {"type": "object", "description": "The versioned core RetrievalRequest, strictly decoded by the Go runner."},
    "candidates": {"type": "array", "items": {"type": "object"}, "description": "Pinned EvidenceCandidate inputs for direct quality-stage cases."},
    "expand": {"type": "object"},
    "expand_times": {"type": "integer", "minimum": 0, "maximum": 32},
    "mutations": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "r1_setup": {"type": "string"},
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"enum": ["COMPLETE", "PARTIAL", "BLOCKED", "UNSUPPORTED", "STALE", "INVALID", "UNKNOWN"]},
        "must_find": {"$ref": "#/$defs/selectors"},
        "should_find": {"$ref": "#/$defs/selectors"},
        "relevant": {"$ref": "#/$defs/selectors"},
        "must_not_find": {"$ref": "#/$defs/selectors"},
        "required_contracts": {"$ref": "#/$defs/selectors"},
        "must_not_route_writes": {"type": "array", "items": {"type": "string"}},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "authority_conflicts": {"type": "array", "items": {"type": "string"}},
        "incomplete_mandatory": {"type": "boolean"},
        "evidence_count": {"type": "integer", "minimum": 0},
        "coverage": {"type": "object", "additionalProperties": {"enum": ["FOUND", "NOT_FOUND_AFTER_COMPLETE_SEARCH", "NOT_VERIFIED", "OMITTED_BY_LIMIT", "UNREADABLE", "UNSUPPORTED", "EXCLUDED_BY_POLICY"]}},
        "counters": {"$ref": "#/$defs/counters"},
        "minimum_counters": {"$ref": "#/$defs/counters"},
        "provenance": {"type": "object", "additionalProperties": {"enum": ["TRUSTED_POLICY", "TRUSTED_PROJECT_METADATA", "PROJECT_SOURCE", "PROJECT_TEST", "PROJECT_DOC", "EXTERNAL_CONTENT", "GENERATED_CONTENT"]}},
        "freshness": {"type": "object", "additionalProperties": {"enum": ["CURRENT", "STALE", "DIRTY_SNAPSHOT", "UNVERIFIED", "MISSING", "INVALIDATED"]}},
        "error_contains": {"type": "string"}
      }
    }
  },
  "$defs": {
    "selectors": {"type": "array", "items": {"$ref": "#/$defs/selector"}},
    "selector": {
      "type": "object", "additionalProperties": false,
      "anyOf": [{"required": ["path"]}, {"required": ["symbol"]}, {"required": ["facet"]}],
      "properties": {"source": {"type": "string"}, "path": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1}, "kind": {"type": "string"}, "revision": {"type": "string"}, "facet": {"type": "string", "minLength": 1}}
    },
    "counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {"source": {"type": "string"}, "path": {"type": "string", "minLength": 1}, "content": {"type": "string"}, "repeat": {"type": "integer", "minimum": 0, "maximum": 300000}, "count": {"type": "integer", "minimum": 0, "maximum": 6000}, "kind": {"enum": ["", "symlink", "fifo", "deleted", "unreadable"]}}
    }
  }
}
