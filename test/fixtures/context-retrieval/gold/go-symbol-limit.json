{
  "schema": "retrieval-gold/v1",
  "id": "go-symbol-limit",
  "scenario": "Go symbols clipped explicitly",
  "mode": "prepare",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    },
    "required_facets": [
      {
        "id": "declarations",
        "kind": "source",
        "query_kind": "declarations",
        "source_identity": "fixture",
        "path": "source.go",
        "claim_type": "implementation_behavior"
      }
    ],
    "limits": {
      "max_symbol_matches": 1
    }
  },
  "expected": {
    "status": "PARTIAL",
    "diagnostics": [
      "RESULT_LIMIT"
    ],
    "must_find": [
      {
        "path": "source.go",
        "symbol": "sample.First"
      }
    ],
    "must_not_find": [
      {
        "path": "source.go",
        "symbol": "sample.Second"
      }
    ],
    "incomplete_mandatory": true
  },
  "files": [
    {
      "path": "source.go",
      "content": "package sample\nfunc First(){}\nfunc Second(){}\n"
    }
  ]
}
