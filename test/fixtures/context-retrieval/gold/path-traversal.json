{
  "schema": "retrieval-gold/v1",
  "id": "path-traversal",
  "scenario": "Facet traversal rejected before file access",
  "mode": "prepare",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    },
    "required_facets": [
      {
        "id": "escape",
        "kind": "source",
        "query_kind": "exact",
        "source_identity": "fixture",
        "path": "../outside.go",
        "claim_type": "implementation_behavior"
      }
    ]
  },
  "expected": {
    "status": "INVALID",
    "error_contains": "unsafe facet path",
    "must_not_find": [
      {
        "path": "../outside.go"
      }
    ]
  },
  "files": [],
  "adversarial": true
}
