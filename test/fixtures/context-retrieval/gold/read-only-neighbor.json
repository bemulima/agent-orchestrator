{
  "schema": "retrieval-gold/v1",
  "id": "read-only-neighbor",
  "scenario": "Admitted neighbor supplies read-only evidence",
  "mode": "prepare",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      },
      {
        "identity": "neighbor",
        "read_paths": [
          "."
        ],
        "read_only_neighbor": true
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    },
    "required_facets": [
      {
        "id": "source",
        "kind": "source",
        "query_kind": "exact",
        "source_identity": "fixture",
        "path": "source.go",
        "claim_type": "implementation_behavior"
      },
      {
        "id": "contract",
        "kind": "contract",
        "query_kind": "contract",
        "source_identity": "neighbor",
        "path": "contract.go",
        "claim_type": "public_api_contract"
      }
    ]
  },
  "expected": {
    "status": "COMPLETE",
    "must_find": [
      {
        "source": "fixture",
        "path": "source.go"
      },
      {
        "source": "neighbor",
        "path": "contract.go"
      }
    ],
    "must_not_route_writes": [
      "neighbor"
    ]
  },
  "files": [
    {
      "path": "source.go",
      "content": "package sample\nfunc Target(){}\n",
      "source": "fixture"
    },
    {
      "path": "contract.go",
      "content": "package neighbor\ntype Port interface { Call() }\n",
      "source": "neighbor"
    }
  ]
}
