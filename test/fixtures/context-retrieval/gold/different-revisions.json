{
  "schema": "retrieval-gold/v1",
  "id": "different-revisions",
  "scenario": "Same path different revision not deduplicated",
  "mode": "quality",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    }
  },
  "expected": {
    "status": "PARTIAL",
    "must_find": [
      {
        "path": "source.go",
        "revision": "revision:gold"
      }
    ],
    "must_not_find": [
      {
        "path": "source.go",
        "revision": "revision:old"
      }
    ],
    "diagnostics": [
      "EVIDENCE_FRESHNESS_INVALIDATED"
    ],
    "evidence_count": 1
  },
  "candidates": [
    {
      "relative_path": "source.go",
      "content": "Old revision",
      "source_revision": "revision:old"
    },
    {
      "relative_path": "source.go",
      "content": "Current revision"
    }
  ]
}
