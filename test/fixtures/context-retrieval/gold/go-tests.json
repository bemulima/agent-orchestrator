{
  "schema": "retrieval-gold/v1",
  "id": "go-tests",
  "scenario": "Executable test association without certification",
  "mode": "prepare",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    },
    "required_facets": [
      {
        "id": "tests",
        "kind": "source",
        "query_kind": "tests",
        "source_identity": "fixture",
        "path": "source.go",
        "claim_type": "implementation_behavior",
        "symbol": "Target"
      }
    ]
  },
  "expected": {
    "status": "COMPLETE",
    "must_find": [
      {
        "path": "source_test.go",
        "kind": "test"
      }
    ]
  },
  "files": [
    {
      "path": "source.go",
      "content": "package sample\nfunc Target() int { return 1 }\n"
    },
    {
      "path": "source_test.go",
      "content": "package sample\nimport \"testing\"\nfunc TestTarget(t *testing.T) { if Target()!=1 {t.Fatal(\"bad\") } }\n"
    }
  ]
}
