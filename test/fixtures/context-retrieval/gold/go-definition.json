{
  "schema": "retrieval-gold/v1",
  "id": "go-definition",
  "scenario": "Go definition found",
  "mode": "prepare",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    },
    "required_facets": [
      {
        "id": "definition",
        "kind": "source",
        "query_kind": "definition",
        "source_identity": "fixture",
        "path": "source.go",
        "claim_type": "implementation_behavior",
        "symbol": "Target"
      }
    ]
  },
  "expected": {
    "status": "COMPLETE",
    "must_find": [
      {
        "path": "source.go",
        "symbol": "sample.Target",
        "kind": "definition"
      }
    ],
    "coverage": {
      "definition": "FOUND"
    }
  },
  "files": [
    {
      "path": "source.go",
      "content": "package sample\nfunc Target() int { return 1 }\n"
    }
  ]
}
