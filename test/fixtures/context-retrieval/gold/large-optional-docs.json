{
  "schema": "retrieval-gold/v1",
  "id": "large-optional-docs",
  "scenario": "Large optional documentation evicted as whole coherent unit",
  "mode": "prepare",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 100,
      "max_context_tokens": 65536
    },
    "required_facets": [
      {
        "id": "code",
        "kind": "source",
        "query_kind": "exact",
        "source_identity": "fixture",
        "path": "source.go",
        "claim_type": "implementation_behavior"
      }
    ],
    "optional_facets": [
      {
        "id": "docs",
        "kind": "doc",
        "query_kind": "docs",
        "source_identity": "fixture",
        "path": "README.md",
        "claim_type": "historical_decision"
      }
    ]
  },
  "expected": {
    "status": "COMPLETE",
    "must_find": [
      {
        "path": "source.go"
      }
    ],
    "must_not_find": [
      {
        "path": "README.md"
      }
    ],
    "diagnostics": [
      "CUMULATIVE_SOURCE_BYTES"
    ],
    "evidence_count": 1
  },
  "files": [
    {
      "path": "source.go",
      "content": "package sample\nfunc Target() {}\n"
    },
    {
      "path": "README.md",
      "content": "optional documentation\n",
      "repeat": 4096
    }
  ]
}
