{
  "schema": "retrieval-gold/v1",
  "id": "renamed-symbol",
  "scenario": "Renamed symbol does not fabricate old definition",
  "mode": "prepare",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    },
    "required_facets": [
      {
        "id": "old",
        "kind": "source",
        "query_kind": "definition",
        "source_identity": "fixture",
        "path": "source.go",
        "claim_type": "implementation_behavior",
        "symbol": "Old"
      }
    ]
  },
  "expected": {
    "status": "PARTIAL",
    "coverage": {
      "old": "NOT_FOUND_AFTER_COMPLETE_SEARCH"
    },
    "must_not_find": [
      {
        "path": "source.go",
        "symbol": "sample.Old"
      }
    ]
  },
  "files": [
    {
      "path": "source.go",
      "content": "package sample\nfunc New(){}\n"
    }
  ]
}
