{
  "schema": "retrieval-gold/v1",
  "id": "expand-stale",
  "scenario": "Expand rejects mutated source snapshot",
  "mode": "expand",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    },
    "required_facets": [
      {
        "id": "source",
        "kind": "source",
        "query_kind": "exact",
        "source_identity": "fixture",
        "path": "source.go",
        "claim_type": "implementation_behavior"
      }
    ]
  },
  "expected": {
    "status": "STALE",
    "error_contains": "stale context base"
  },
  "files": [
    {
      "path": "source.go",
      "content": "package sample\nfunc Target() {}\n"
    },
    {
      "path": "extra.go",
      "content": "package sample\nfunc Extra() {}\n"
    }
  ],
  "expand": {
    "facet": {
      "id": "extra",
      "kind": "source",
      "query_kind": "definition",
      "source_identity": "fixture",
      "path": "extra.go",
      "claim_type": "implementation_behavior",
      "symbol": "Extra"
    },
    "reason": "Inspect exact dependency"
  },
  "mutations": [
    {
      "path": "source.go",
      "content": "package sample\nfunc Changed() {}\n"
    }
  ]
}
