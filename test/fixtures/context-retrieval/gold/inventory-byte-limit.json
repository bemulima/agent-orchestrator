{
  "schema": "retrieval-gold/v1",
  "id": "inventory-byte-limit",
  "scenario": "Byte cap retains unknown required source",
  "mode": "prepare",
  "request": {
    "route": {
      "digest": "gold-route/v1",
      "status": "COMPLETE",
      "owners": [
        "fixture"
      ]
    },
    "sources": [
      {
        "identity": "fixture",
        "read_paths": [
          "."
        ]
      }
    ],
    "budget": {
      "max_source_bytes": 1048576,
      "max_context_tokens": 65536
    },
    "required_facets": [
      {
        "id": "required",
        "kind": "source",
        "query_kind": "exact",
        "source_identity": "fixture",
        "path": "z_required.go",
        "claim_type": "implementation_behavior"
      }
    ],
    "limits": {
      "max_total_bytes": 15
    }
  },
  "expected": {
    "status": "PARTIAL",
    "diagnostics": [
      "BYTE_LIMIT"
    ],
    "incomplete_mandatory": true
  },
  "files": [
    {
      "path": "a.go",
      "content": "package sample\n"
    },
    {
      "path": "z_required.go",
      "content": "package sample\nfunc Required(){}\n"
    }
  ]
}
