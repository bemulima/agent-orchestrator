{
  "schema_version": "disposable-provisioner.v1",
  "id": "course-dev-orchestrator-test-postgres",
  "owner_command": "test:integration:deps",
  "dependency": {
    "type": "database",
    "identity": "postgresql/course_dev_orchestrator_test"
  },
  "images": [
    {
      "reference": "postgres:16-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777",
      "purpose": "PostgreSQL used by the disposable owner integration-test command."
    }
  ],
  "toolchain": [
    { "name": "Docker Engine", "version": "28.0.4" },
    { "name": "Docker Compose", "version": "2.38.2" }
  ],
  "lifecycle": {
    "start": {
      "invoke": ["make", "test-integration"],
      "working_directory": ".",
      "timeout_seconds": 120
    },
    "readiness": {
      "method": "sql",
      "semantic_assertion": "The owner script waits for PostgreSQL health, then runs SELECT current_database() in the generated Compose project and verifies the configured database identity before creating the _test database.",
      "invoke": ["scripts/test-integration.sh"],
      "working_directory": ".",
      "timeout_seconds": 60
    },
    "configuration": {
      "environment": ["COMPOSE_PROJECT_NAME", "INTEGRATION_DB_NAME", "POSTGRES_DB", "POSTGRES_PASSWORD", "POSTGRES_PORT", "POSTGRES_USER"],
      "isolation_strategy": "The owner script creates a unique cdo-integration-* Compose project and removes only its project containers, network, and volumes on exit."
    },
    "cleanup": {
      "invoke": ["docker", "compose", "down", "--volumes", "--remove-orphans"],
      "working_directory": ".",
      "timeout_seconds": 60,
      "policy": "remove_all_owned_resources",
      "fail_on_error": true
    }
  }
}
