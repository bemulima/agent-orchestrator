FROM golang:1.25.1-alpine AS builder

WORKDIR /app
ARG VERSION=dev
ARG COMMIT=none
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/course-dev-orchestrator ./cmd/course-dev-orchestrator

FROM node:24-alpine AS runner-builder

WORKDIR /runner
COPY runner/package.json runner/package-lock.json ./
RUN npm ci
COPY runner/tsconfig.json ./
COPY runner/src ./src
COPY runner/bin ./bin
RUN npm run build \
    && npm prune --omit=dev

FROM node:20.19.5-alpine AS policy-runtime

FROM node:24-alpine
COPY --from=policy-runtime /usr/local/bin/node /usr/local/bin/node20
RUN node20 --version

COPY --from=builder /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

RUN apk add --no-cache bubblewrap ca-certificates git openssh-client python3 \
    && addgroup -S orchestrator \
    && adduser -S -G orchestrator orchestrator \
    && mkdir -p /data/repositories /data/worktrees /data/codex /projects \
    && chown -R orchestrator:orchestrator /data /projects
WORKDIR /app
COPY --from=builder /out/course-dev-orchestrator /app/course-dev-orchestrator
COPY --from=builder /app/agent-system /app/agent-system
COPY --from=runner-builder --chown=orchestrator:orchestrator /runner /app/runner
COPY --from=runner-builder /runner/bin/cdo_bwrap.py /usr/local/bin/bwrap
COPY docker/codex-requirements.toml /etc/codex/requirements.toml
RUN mkdir -p /etc/cdo && touch /etc/cdo/gitconfig && chmod 0444 /etc/cdo/gitconfig
RUN chmod 0755 /usr/local/bin/bwrap
COPY release/source-manifest.json /app/release/source-manifest.json
COPY docker/sandbox/profile.v1.json /app/release/profile.v1.json
COPY agent-system/manifest.yaml /app/release/role-policy.json
COPY scripts/release-build-identity.py /tmp/release-build-identity.py
RUN python3 /tmp/release-build-identity.py && chmod -R a-w /app/release /app/runner
USER orchestrator
EXPOSE 8080
ENTRYPOINT ["/app/course-dev-orchestrator"]
CMD ["serve"]
